# Copy this file to .env.local and fill in your API keys

# Gemini API Key (required for Gemini provider)
GEMINI_API_KEY=

# GLM Provider (z.ai) - OpenAI-compatible API
# Get your API key from Z.AI console
VITE_ZAI_API_KEY=

# OpenRouter Provider - Multi-model routing API
# Get your API key from https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# MegaLLM Provider - Unified multi-provider API (70+ models)
# Get your API key from https://megallm.io/dashboard
VITE_MEGALLM_API_KEY=
